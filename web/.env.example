# ---------------------------------------------------------------------------
# Web Agent 前端配置（复制为 .env 或 .env.local 后按需修改）
# ---------------------------------------------------------------------------

# Agent 后端地址（唯一上游；前端不直连 APS）
#   /agent                      推荐：同源相对路径，由 vite 代理转发（无需 CORS）
#   http://127.0.0.1:8100       直连 agent（agent 已开启 CORS）
#   http://agent:8100           容器内直连（浏览器无法解析该主机名，勿用于此方式）
VITE_AGENT_BASE_URL=/agent

# vite 代理目标（仅当 VITE_AGENT_BASE_URL 使用相对路径时生效）
#   本地开发：http://127.0.0.1:8100
#   docker compose 内：http://agent:8100
VITE_PROXY_TARGET=http://127.0.0.1:8100
