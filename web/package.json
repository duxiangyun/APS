{
  "name": "aps-workbuddy-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --log-level=error --define:import.meta.env='{\"VITE_AGENT_BASE_URL\":\"/agent\"}' --outfile=node_modules/.cache/smoke.cjs && node node_modules/.cache/smoke.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.22.2",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
