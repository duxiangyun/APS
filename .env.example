# APS 一键部署环境变量样例（复制为 .env 后填写；.env 不会提交 Git）
# 用法: cp .env.example .env && vi .env

# LLM 配置（OpenAI 兼容；留空则 agent 以降级模式运行）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.7-flash
LLM_FALLBACK_MODEL=qwen3.7-plus

# APS 后端地址（docker compose 网络内互访，一般无需修改）
APS_BASE_URL=http://aps:8000

# agent 审计库路径（容器内路径）
AGENT_DB_PATH=/app/data/audit.db
