# Web Agent 后端环境变量样例（复制为 .env 使用）

# APS 后端地址（docker-compose 内为 http://aps:8000）
APS_BASE_URL=http://127.0.0.1:8000

# LLM 配置（OpenAI 兼容；配置后启用自然语言对话，否则为降级模式）
LLM_BASE_URL=https://ws-omrnql6yijszps7a.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen3.7-flash
LLM_FALLBACK_MODEL=qwen3.7-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ReAct 循环与日志
MAX_TOOL_ROUNDS=6
TOOL_LOG_PATH=

# 服务端口
PORT=8100
